# ---- Vision model (any OpenAI-compatible endpoint) ----
# Default: local Ollama (https://ollama.com) — `ollama pull qwen3-vl:4b-instruct`
VISION_BASE_URL=http://localhost:11434/v1
VISION_MODEL=qwen3-vl:4b-instruct
VISION_API_KEY=ollama

# Stronger local GPU:
# VISION_MODEL=qwen3-vl:8b-instruct

# Hosted (no local model needed), e.g. OpenRouter:
# VISION_BASE_URL=https://openrouter.ai/api/v1
# VISION_MODEL=qwen/qwen3-vl-8b-instruct
# VISION_API_KEY=sk-or-...

# vLLM on a Linux GPU server:
# VISION_BASE_URL=http://gpu-server:8000/v1
# VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct-FP8
# VISION_API_KEY=EMPTY

# Seconds before a single model call times out (CPU inference can be slow)
VISION_TIMEOUT=180

# ---- Backend ----
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Device agent ----
API_URL=http://localhost:8000
DEVICE_ID=webcam-01
